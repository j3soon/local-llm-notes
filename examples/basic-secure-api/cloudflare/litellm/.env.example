# Use a NEW Cloudflare Tunnel and hostname for the proxy, separate from vLLM.
# Point the tunnel's public hostname to http://nginx:80 (API only; UI is blocked).
SERVER_NAME=proxy.example.com
CLOUDFLARE_TUNNEL_TOKEN=your_proxy_tunnel_token_here

# Generate each independently with: openssl rand -hex 32
# Keep the salt unchanged for this database; it encrypts stored credentials.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me
# Client virtual key; register it with ./scripts/create_virtual_key.sh.
APP_API_KEY=sk-change-me
# Use a hex password (URL-safe in DATABASE_URL).
POSTGRES_PASSWORD=change-me
LITELLM_LOG=INFO
# Bind host access to loopback; Cloudflare Tunnel provides public access.
# No local access: remove/comment litellm's ports section in compose.yaml.
# LITELLM_BIND selects the address; setting it empty cannot disable the mapping.
LITELLM_BIND=127.0.0.1:
LITELLM_PORT=14000

# Model names and provider prefixes are configured in litellm-config.yaml.
# Empty keys are allowed here; comment out the corresponding model blocks
# and virtual-key permissions in litellm-config.yaml before starting the proxy.
OPENAI_API_KEY=

# Azure resource root URL (not /openai/deployments/...); names live in YAML.
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com
# LiteLLM selects Azure's current /openai/v1/ API without a dated api-version.
AZURE_API_VERSION=v1

# Existing authenticated Qwen endpoint, including /v1. Do not use the proxy URL.
# Copy LLM_API_KEY from the EXISTING vLLM deployment as VLLM_API_KEY here.
VLLM_API_BASE=https://llm.example.com/v1
VLLM_API_KEY=
# Occasionally powered-on secondary Qwen server, including /v1; its LLM_API_KEY.
# Without a secondary, comment out the qwen-secondary block in litellm-config.yaml.
VLLM_API_BASE_SECONDARY=https://llm-secondary.example.com/v1
VLLM_API_KEY_SECONDARY=
