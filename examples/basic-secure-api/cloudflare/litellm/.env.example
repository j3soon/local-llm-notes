# Separate proxy tunnel: public hostname -> http://nginx:80 (API only; no UI).
SERVER_NAME=proxy.example.com
CLOUDFLARE_TUNNEL_TOKEN=your_proxy_tunnel_token_here

# Generate independent secrets with: openssl rand -hex 32
# Keep the salt unchanged; it encrypts this database's stored credentials.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me
# Append keys: ./scripts/gen_env.sh; register: ./scripts/create_virtual_key.sh.
# Native /key/generate objects; omitted models or [] uses the YAML default (Qwen).
# all-proxy-models includes future models. JSON forbids trailing commas.
APP_API_KEYS='[
  {"key_alias":"full-access","key":"sk-change-me-full","models":["all-proxy-models"]},
  {"key_alias":"qwen-only","key":"sk-change-me-qwen"}
]'
# Use a hex password (URL-safe in DATABASE_URL).
POSTGRES_PASSWORD=change-me
LITELLM_LOG=INFO
# Local UI/API: loopback only. Remove litellm.ports in compose.yaml to disable.
# LITELLM_BIND needs a trailing colon; empty does not disable port publishing.
LITELLM_BIND=127.0.0.1:
LITELLM_PORT=14000

# Models and permissions: litellm-config.yaml. Comment out unused model blocks
# and explicit key permissions; empty provider keys alone do not disable models.
OPENAI_API_KEY=

# Azure resource root URL; deployment names live in litellm-config.yaml.
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com
# v1 uses /openai/v1/ without a dated api-version.
AZURE_API_VERSION=v1

# Upstream vLLM URL including /v1; copy its LLM_API_KEY as VLLM_API_KEY.
VLLM_API_BASE=https://llm.example.com/v1
VLLM_API_KEY=
# Optional secondary: same URL/key convention. Without it, comment out the
# qwen-secondary block in litellm-config.yaml.
VLLM_API_BASE_SECONDARY=https://llm-secondary.example.com/v1
VLLM_API_KEY_SECONDARY=
